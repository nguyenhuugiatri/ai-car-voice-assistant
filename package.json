{
  "name": "ai-car-voice-assistant",
  "private": true,
  "version": "0.0.0",
  "description": "A car head unit simulator you control by voice, running in the browser",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "deploy": "vercel deploy --prod --yes"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.66",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/saira": "^5.3.0",
    "@mlc-ai/web-llm": "^0.2.85",
    "@number-flow/react": "^0.6.2",
    "@rive-app/react-webgl2": "^4.34.1",
    "@tailwindcss/vite": "^4.3.3",
    "ai": "^7.0.99",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.43.0",
    "nitro": "3.0.260903-beta",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@webgpu/types": "^0.1.72",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
